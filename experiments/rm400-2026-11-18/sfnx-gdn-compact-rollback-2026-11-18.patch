+// 2026-11-18: each compact update is [decay, key[HS], delta[HS]]
+// for one head and row, following one full checkpoint (row 0).
+constexpr int GDN_UPDATE = 1 + 2 * HS;
+__device__ __forceinline__ float gdn_update(float prior, float decay, float key, float delta) {
+    return fmaf(key, delta, __fmul_rn(decay, prior));
