@@ -216,1 +216,21 @@
 constexpr int QSA_SEL_THREADS = 1024;
+
+// 2026-11-18: each warp scans its own count; a warp-total prefix
+// gives the exact block-wide offset without a block barrier per bit.
+__device__ __forceinline__ int qsa_exclusive_count(int count, int* warp_totals) {
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    int sum = count;
+#pragma unroll
+    for (int d = 1; d < 32; d <<= 1) {
+        int prev = __shfl_up_sync(0xffffffffu, sum, d);
+        if (lane >= d) sum += prev;
+    }
+    if (lane == 31) warp_totals[warp] = sum;
+    __syncthreads();
+    if (warp == 0) {
+        int total = warp_totals[lane], own = total;
+#pragma unroll
+        for (int d = 1; d < 32; d <<= 1) {
+            int prev = __shfl_up_sync(0xffffffffu, total, d);
+            if (lane >= d) total += prev;
+        }
+        warp_totals[lane] = total - own;
+    }
+    __syncthreads();
+    return sum - count + warp_totals[warp];
+}
