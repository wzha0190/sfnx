                     static const bool single_job = env_flag("FNX_RM400_Q4K_SINGLE_JOB");
+                    // 2026-11-19: test scheduling granularity on the
+                    // same quantization and lane-local arithmetic.
+                    static const int threads = [] {
+                        const auto n = env_int("FNX_RM400_Q4K_GATE_THREADS", Q4K_THREADS);
+                        if (n != 128 && n != 192 && n != Q4K_THREADS)
+                            throw std::runtime_error("FNX_RM400_Q4K_GATE_THREADS: expected 128, 192 or 256");
