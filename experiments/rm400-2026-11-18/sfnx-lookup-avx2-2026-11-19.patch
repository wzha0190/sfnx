+#if defined(__x86_64__) && (defined(__GNUC__) || defined(__clang__))
+__attribute__((target("avx2")))
+static size_t lookup_latest_avx2(const int* ctx, size_t n) {
+    static_assert(LOOKUP_N == 3);
+    const __m256i a = _mm256_set1_epi32(ctx[n]), b = _mm256_set1_epi32(ctx[n + 1]), c = _mm256_set1_epi32(ctx[n + 2]);
+    size_t end = n;
+    while (end >= 8) {
+        const size_t i = end - 8;
+        const __m256i x = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(ctx + i));
+        const __m256i y = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(ctx + i + 1));
+        const __m256i z = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(ctx + i + 2));
+        const __m256i same = _mm256_and_si256(_mm256_cmpeq_epi32(x, a),
+                             _mm256_and_si256(_mm256_cmpeq_epi32(y, b), _mm256_cmpeq_epi32(z, c)));
+        const unsigned mask = (unsigned) _mm256_movemask_ps(_mm256_castsi256_ps(same));
+        if (mask) return i + 31 - __builtin_clz(mask);
+        end = i;
+    }
+    while (end) {
+        --end;
+        if (ctx[end] == ctx[n] && ctx[end + 1] == ctx[n + 1] && ctx[end + 2] == ctx[n + 2]) return end;
+    }
+    return n;
+}
