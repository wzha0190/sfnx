+
+__global__ void __launch_bounds__(QSA_DIM) k_idx_prep_pool_lanes(const float* y, const float* qn, const float* kn, int ring_rows,
+                                                               float* q, __half* pooled, KvPages g, LaneAttPrep prep, float eps, Rope base) {
+    const int t = blockIdx.x;
+    base.tab = prep.rot[t];
+    // Pool current-segment keys from y (rounded to half), not the ring
+    // that the other blocks are concurrently updating.
+    const int first = prep.first[t], offset = t - first;
+    idx_prep_pool_row(y + (size_t) first * QSA_ROWS, qn, kn, reinterpret_cast<__half*>(prep.ring[t]), ring_rows, q, pooled,
+                      row_pages(g, prep.rows, t), t, row_pos(prep.rows, nullptr, t) - offset, offset, eps, base);
+}
