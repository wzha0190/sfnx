+        f();
+        cudaEventRecord(b);
+        if (cudaEventSynchronize(b) != cudaSuccess) throw std::runtime_error("timed CUDA launch failed");
+        float ms = 0.f;
+        cudaEventElapsedTime(&ms, a, b);
+        times.push_back(ms);
+    }
+    cudaEventDestroy(a);
+    cudaEventDestroy(b);
+    std::sort(times.begin(), times.end());
