+// 2026-11-19: unpack a Q5_1 weight block once, not once per token.
+// Keep the two groups of four DP4As and their separately rounded
+// scale/min terms in the same order as llama.cpp's MMVQ implementation.
+struct DownQ5 {
+    half2 dm;
+    int lo[4], hi[4];
+};
+
+__device__ __forceinline__ DownQ5 read_down_q5(const block_q5_1& w) {
+    DownQ5 p;
+    p.dm = w.dm;
+    const unsigned high = (unsigned) get_int_b4(w.qh, 0);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const unsigned low = (unsigned) get_int_b4(w.qs, i), h = high >> (4 * i);
+        p.lo[i] = (low & 0x0f0f0f0fu) | ((h << 4) & 0x00000010u) | ((h << 11) & 0x00001000u) |
+                  ((h << 18) & 0x00100000u) | ((h << 25) & 0x10000000u);
+        p.hi[i] = ((low >> 4) & 0x0f0f0f0fu) | ((h >> 12) & 0x00000010u) | ((h >> 5) & 0x00001000u) |
+                  ((h << 2) & 0x00100000u) | ((h << 9) & 0x10000000u);
+    }
+    return p;
+}
+
+template <int FIRST>
+__device__ __forceinline__ float down_q5_half(const DownQ5& p, const block_q8_1& x, float d, float m) {
+    int dots = 0;
+#pragma unroll
+    for (int i = FIRST; i < FIRST + VDR_Q5_1_Q8_1_MMVQ; ++i) {
+        dots = ggml_cuda_dp4a(p.lo[i], get_int_b4(x.qs, i), dots);
+        dots = ggml_cuda_dp4a(p.hi[i], get_int_b4(x.qs, i + QI5_1), dots);
+    }
+    return dots * d + m / (QI5_1 / VDR_Q5_1_Q8_1_MMVQ);
+}
+
+__device__ __forceinline__ float down_q5_dot(const DownQ5& p, const block_q8_1& x) {
+    static_assert(QI5_1 == 4 && VDR_Q5_1_Q8_1_MMVQ == 2);
+#ifdef FAST_FP16_AVAILABLE
+    const float2 dm = __half22float2(__hmul2(p.dm, x.ds));
+#else
+    const float2 w = __half22float2(p.dm), a = __half22float2(x.ds);
+    const float2 dm = make_float2(w.x * a.x, w.y * a.y);
+#endif
+    float s = 0.f;
+    s += down_q5_half<0>(p, x, dm.x, dm.y);
+    s += down_q5_half<2>(p, x, dm.x, dm.y);
+    return s;
+}
