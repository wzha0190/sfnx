diff --git a/src/moe.cuh b/src/moe.cuh
--- a/src/moe.cuh
+++ b/src/moe.cuh
@@ -19,1 +19,2 @@
-__device__ void cache_plan(const Job* jobs, int nj, int layer, const ExpertCache& ec, int* list) {
+__device__ void cache_plan(const Job* jobs, int nj, int layer, const ExpertCache& ec, int* list,
+                           bool fast_hits) {
@@ -26,1 +27,21 @@
     const int s0 = ec.s0[p] + lent, n = ec.n[p] - lent;
+#if FNX_ARCH == 70 && !FNX_27B && FNX_NCARD == 3
+    // 2026-11-19: keep up to two job slots per lane. With no misses,
+    // omit the transient ref=2 pin but preserve CLOCK normalization.
+    if (fast_hits && nj <= 64) {
+        const int slot0 = lane < nj ? ec.slot_of[base + jobs[lane].w] : -1;
+        const int slot1 = lane + 32 < nj ? ec.slot_of[base + jobs[lane + 32].w] : -1;
+        const bool miss = (lane < nj && slot0 < 0) || (lane + 32 < nj && slot1 < 0);
+        if (!__any_sync(0xffffffffu, miss)) {
+            if (slot0 >= 0) ec.ref[slot0] = 1;
+            if (slot1 >= 0) ec.ref[slot1] = 1;
+            if (lane == 0) {
+                const int hand = ec.hand[p] - s0;
+                ec.hand[p] = s0 + ((hand < 0 || hand >= n) ? 0 : hand);
+                list[0] = 0;
+            }
+            return;
+        }
+    }
+#endif
@@ -78,2 +99,2 @@
-                                                            const ExpertCache ec, int layer, int* list, const ShexpUp su) {
+                                                            const ExpertCache ec, int layer, int* list, const ShexpUp su, bool fast_hits) {
     static_assert(RR_THREADS == Q8S_THREADS, "the shared expert's q8s blocks in the router's launch");
@@ -224,2 +245,2 @@
